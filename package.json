{
  "name": "paseo-notify",
  "private": true,
  "version": "0.1.0",
  "description": "Notify an Apple Watch when a Paseo agent truly finishes or needs a permission decision.",
  "scripts": {
    "typecheck:plugin": "npm --prefix packages/plugin run typecheck",
    "test:plugin": "npm --prefix packages/plugin run test",
    "typecheck:gateway": "npm --prefix services/gateway run typecheck",
    "test:gateway": "npm --prefix services/gateway run test",
    "build:gateway": "npm --prefix services/gateway run build",
    "typecheck:worker": "npm --prefix services/gateway-worker run typecheck",
    "test:worker": "npm --prefix services/gateway-worker run test",
    "parity": "npm --prefix services/gateway run parity",
    "verify:gateways": "npm run typecheck:gateway && npm run test:gateway && npm run typecheck:worker && npm run test:worker && npm run parity",
    "dev:worker": "npm --prefix services/gateway-worker run dev",
    "deploy:worker": "npm --prefix services/gateway-worker run deploy",
    "apps:generate": "cd apps && xcodegen generate"
  }
}
