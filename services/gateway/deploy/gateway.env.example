# Environment for the gateway. Copy to .env (or /etc/paseo-notify/gateway.env) and fill in.
# Never commit real values.

PORT=8787

# NOTE: there is no gateway-wide token. Callers (the plugin and the watch app) authenticate with
# their OWN channel secret, sent as `Authorization: Bearer <secret>`. Devices are stored per channel
# (keyed by the secret's SHA-256), so users never see or push to each other's devices.

# Where the registered device tokens are persisted. Must be writable and persistent.
DEVICES_FILE=/data/devices.json

# APNs provider key (Apple Developer -> Certificates, Identifiers & Profiles -> Keys).
APNS_KEY_PATH=/secrets/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.romejiang.paseonotify

# Fallback environment for devices that do not report one. Devices normally send their own.
APNS_ENV=production

# Rate limiting (in-memory, fixed window). Per-channel is the real protection: one noisy user
# cannot affect others. Per-IP guards unauthenticated floods.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_CHANNEL=60
RATE_LIMIT_PER_IP=120
RATE_LIMIT_WINDOW_MS=60000
